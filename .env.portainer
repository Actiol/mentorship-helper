# ================================================================================================
# Mentorship Helper - Portainer Environment Configuration
# Domain: mentorship.actiol.dev
# ================================================================================================
# 
# IMPORTANT: This is the PRODUCTION environment file template for Portainer deployment.
# Copy this file to your Portainer environment and replace all placeholder values.
# 
# DO NOT commit secrets to version control. Set these securely in Portainer's stack environment.
# ================================================================================================

# ──────────────────────────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────────────────────

# PostgreSQL credentials - Use strong, randomly generated passwords
# Generate with: openssl rand -hex 32
POSTGRES_USER=mentorship
POSTGRES_PASSWORD=YOUR_STRONG_DB_PASSWORD_HERE_CHANGE_ME
POSTGRES_DB=mentorship

# ──────────────────────────────────────────────────────────────────────────────────────────────
# API CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────────────────────

# JWT Secret for token signing - MUST be strong and random
# Generate with: openssl rand -hex 32
JWT_SECRET=YOUR_JWT_SECRET_64_HEX_CHARS_HERE_CHANGE_ME

# osu! OAuth Application Credentials
# Register at: https://osu.ppy.sh/home/account/edit#oauth
OSU_CLIENT_ID=YOUR_OSU_CLIENT_ID_HERE
OSU_CLIENT_SECRET=YOUR_OSU_CLIENT_SECRET_HERE

# Public domain URL where the service is accessible (NO trailing slash)
BASE_URL=https://mentorship.actiol.dev

# Allowed CORS origins (comma-separated)
# The osu! website needs access to your API
ALLOWED_ORIGINS=https://osu.ppy.sh

# Discord Bot Token - from Discord Developer Portal
# Get at: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# API Logging Level (debug, info, warning, error)
LOG_LEVEL=info

# ──────────────────────────────────────────────────────────────────────────────────────────────
# BOT CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────────────────────

# Discord Bot Token (same as DISCORD_BOT_TOKEN)
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Discord Application Client ID
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID_HERE

# Base URL for osu! verification link sent to Discord users
OSU_VERIFY_BASE_URL=https://mentorship.actiol.dev/auth/discord-verify

# Internal API base URL (Docker network access is preferred)
# Can be either internal (api:8000) or external URL
API_BASE_URL=https://mentorship.actiol.dev

# Shared secret for bot → API communication
# MUST match API_BOT_SECRET in bot verification
# Generate with: openssl rand -hex 32
API_BOT_SECRET=YOUR_API_BOT_SECRET_64_HEX_CHARS_HERE_CHANGE_ME

# ──────────────────────────────────────────────────────────────────────────────────────────────
# DOCKER & PORTAINER CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────────────────────

# Docker registry for images (leave empty to use Docker Hub)
# Example: your-registry.com/mentorship (without trailing slash)
DOCKER_REGISTRY=

# Image tags for each service
API_TAG=latest
BOT_TAG=latest
NGINX_TAG=latest

# Ports to expose (change if ports are already in use)
HTTP_PORT=80
HTTPS_PORT=443

# Server name (for nginx configuration)
SERVER_NAME=mentorship.actiol.dev

# ──────────────────────────────────────────────────────────────────────────────────────────────
# SETUP INSTRUCTIONS
# ──────────────────────────────────────────────────────────────────────────────────────────────
# 
# 1. Generate secure secrets:
#    JWT_SECRET=$(openssl rand -hex 32)
#    POSTGRES_PASSWORD=$(openssl rand -hex 32)
#    API_BOT_SECRET=$(openssl rand -hex 32)
# 
# 2. Register OAuth Applications:
#    - osu! OAuth: https://osu.ppy.sh/home/account/edit#oauth
#    - Discord Bot: https://discord.com/developers/applications
# 
# 3. In Portainer:
#    - Create new Stack
#    - Paste docker-compose.prod.yml content
#    - Add environment variables from this file
#    - Deploy
# 
# 4. SSL/TLS Certificates:
#    - Copy fullchain.pem and privkey.pem to ./nginx/certs/
#    - Or use certbot to auto-renew:
#      docker run -it --rm -p 80:80 -v /path/to/certs:/etc/letsencrypt \
#        certbot/certbot certonly --standalone -d mentorship.actiol.dev
# 
# 5. Verify deployment:
#    curl https://mentorship.actiol.dev/health
#    curl https://mentorship.actiol.dev/docs (API docs)
# 
# ──────────────────────────────────────────────────────────────────────────────────────────────
