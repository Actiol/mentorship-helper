# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=mentorship
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=mentorship

# ── API ───────────────────────────────────────────────────────────────────────
# JWT secret: generate with:  openssl rand -hex 32
JWT_SECRET=replace_me_with_64_hex_chars

# Your osu! OAuth app — register at https://osu.ppy.sh/home/account/edit#oauth
OSU_CLIENT_ID=your_osu_oauth_client_id
OSU_CLIENT_SECRET=your_osu_oauth_client_secret

# The public URL of this server (no trailing slash)
BASE_URL=https://mentorship.yourdomain.com

# Origins allowed to call the API with credentials (the osu! website)
ALLOWED_ORIGINS=https://osu.ppy.sh

# ── Discord ───────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_TOKEN=your_discord_bot_token      # same token, used by the bot service
DISCORD_CLIENT_ID=your_discord_application_id

# ── Bot → API ─────────────────────────────────────────────────────────────────
# The bot POSTs .osz files to the API. This shared secret authorises those calls.
# Generate with:  openssl rand -hex 32
API_BOT_SECRET=replace_me_with_another_secret

# The bot calls this URL when uploading maps (internal Docker network is fine too)
API_BASE_URL=https://mentorship.yourdomain.com

# The verify link the bot sends to Discord users
OSU_VERIFY_BASE_URL=https://mentorship.yourdomain.com/auth/discord-verify
